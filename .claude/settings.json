{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(.venv/bin/pytest *)",
      "Bash(.venv/bin/python -m phishguard *)",
      "Bash(.venv/bin/pip install *)",
      "Bash(.venv/bin/python -c *)",
      "Bash(python3.12 -m venv .venv)",
      "Bash(python3.11 -m venv .venv)",
      "Bash(python3.13 -m venv .venv)",
      "Bash(git init)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(mkdir -p logs)",
      "Bash(tail *)"
    ],
    "ask": [
      "Edit(/tests/**)",
      "Edit(/specs/**)",
      "Bash(git push *)"
    ],
    "deny": [
      "Edit(/data/raw/**)"
    ]
  }
}
